# Public site URL (used for canonical/OG metadata + sitemap)
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Business identity (overrides the defaults in config/site.ts)
NEXT_PUBLIC_COMPANY_NAME=
NEXT_PUBLIC_PHONE_NUMBER=
NEXT_PUBLIC_EMAIL=

# Lead webhook endpoint (Zapier / Make.com / n8n / GoHighLevel / custom API).
# When empty, submissions are logged to the browser console instead of POSTed.
NEXT_PUBLIC_WEBHOOK_URL=
