# Google Ads API access for the Bathroom Excellence account.
# Copy to .env.google-ads.local (git-ignored) and fill in. Setup guide: docs/google-ads-api.md
#
#   npm run ads:auth      # mints GOOGLE_ADS_REFRESH_TOKEN (one-time, needs a browser)
#   npm run ads:pull -- accounts | leads | service-area | all

# Step 1 — from the MANAGER account: Google Ads → Admin → API Center
GOOGLE_ADS_DEVELOPER_TOKEN=

# Step 2 — Google Cloud Console → APIs & Services → Credentials → OAuth client ("Desktop app")
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=

# Step 3 — produced by `npm run ads:auth` (sign in as the Google user that manages the ads)
GOOGLE_ADS_REFRESH_TOKEN=

# Step 4 — which account to read. Digits only or 123-456-7890, both work.
#   LOGIN_CUSTOMER_ID: the manager (MCC) account that owns the developer token and links the client.
#                      Leave empty if the authorising user accesses the client account directly.
#   CUSTOMER_ID:       the Bathroom Excellence client account the reports are for.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_CUSTOMER_ID=

# Optional
# GOOGLE_ADS_API_VERSION=v25
