# Public site URL (used for canonical/OG metadata + sitemap)
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Business identity (overrides the defaults in config/site.ts)
NEXT_PUBLIC_COMPANY_NAME=
NEXT_PUBLIC_PHONE_NUMBER=
NEXT_PUBLIC_EMAIL=

# Lead webhook endpoint (Zapier / Make.com / n8n / GoHighLevel / custom API).
# When empty, submissions are logged to the browser console instead of POSTed.
NEXT_PUBLIC_WEBHOOK_URL=

# ── Google Ads conversion tracking ──────────────────────────────────────────
# Reports estimate requests to Google Ads so campaigns bid toward leads.
# Leave the tag ID empty to disable tracking entirely (nothing loads, nothing fires).
# The Google tag ID, from Google Ads → Goals → Conversions → the action's tag setup.
NEXT_PUBLIC_GOOGLE_ADS_TAG_ID=

# Conversion label per project type, plus a "default" fallback. The label is the
# part after the slash in the snippet's send_to: 'AW-123456789/<label>'.
# Keys match the wizard's project types and the per-service conversion actions:
#   shower-remodel · tub-to-shower-conversion · walk-in-shower
#   full-bathroom-remodel · bathroom-safety-upgrade
# NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABELS={"default":"AbC-1","shower-remodel":"AbC-2"}
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABELS=

# Optional value in dollars per project type, so Google bids toward the work
# worth having rather than counting every lead equally. Omit to use the $1
# default set on the conversion action.
# NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_VALUES={"default":250,"full-bathroom-remodel":600}
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_VALUES=

# Send hashed contact details to improve match rates ("enhanced conversions").
# Requires accepting Google's enhanced conversions terms and disclosing it in
# the privacy policy. Anything other than "true" leaves it off.
NEXT_PUBLIC_GOOGLE_ADS_ENHANCED_CONVERSIONS=
